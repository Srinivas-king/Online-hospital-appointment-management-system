{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "rootDir": "backend/src",
        "outDir": "backend/dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "backend/src/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "backend/dist"
    ]
}